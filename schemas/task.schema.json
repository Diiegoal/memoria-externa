{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/memoria/task.schema.json",
  "title": "task",
  "description": "Proposed local data contract. It does not imply independent historical or third-party verification.",
  "type": "object",
  "required": [
    "id",
    "project_id",
    "title",
    "status",
    "schema_version",
    "created_at",
    "updated_at",
    "acceptance_criteria",
    "dependencies",
    "source_refs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TASK-\\d{4}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "backlog",
        "in_progress",
        "blocked",
        "done",
        "cancelled"
      ]
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "due_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
