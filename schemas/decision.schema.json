{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/memoria/decision.schema.json",
  "title": "decision",
  "description": "Proposed local data contract. It does not imply independent historical or third-party verification.",
  "type": "object",
  "required": [
    "id",
    "project_id",
    "title",
    "status",
    "schema_version",
    "decided_at",
    "alternatives",
    "rationale",
    "approved_by",
    "source_refs",
    "consequences"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DEC-\\d{4}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "confirmed",
        "rejected",
        "superseded",
        "pending"
      ]
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "proposed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "decided_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consequences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
