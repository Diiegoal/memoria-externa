{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/memoria/event.schema.json",
  "title": "event",
  "description": "Proposed local data contract. It does not imply independent historical or third-party verification.",
  "type": "object",
  "required": [
    "event_id",
    "project_id",
    "event_type",
    "occurred_at",
    "recorded_at",
    "source_ref",
    "schema_version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^EV-\\d{4}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "entity_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "actor": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "correction_of": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
