{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/memoria/session.schema.json",
  "title": "session",
  "description": "Proposed local data contract. It does not imply independent historical or third-party verification.",
  "type": "object",
  "required": [
    "id",
    "project_id",
    "chat_id",
    "schema_version",
    "status",
    "summary",
    "facts",
    "questions",
    "decisions",
    "task_refs",
    "source_refs",
    "next_actions",
    "raw_refs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^S-\\d{8}-\\d{3}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "chat_id": {
      "const": "chat-1"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "closed",
        "verified"
      ]
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "ended_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "task_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raw_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
